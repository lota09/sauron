# git
.gitattributes
.gitignore

# 런타임 산출물(스크립트로 재생성 가능)
db/notice.db
db/notice.db-wal
db/notice.db-shm

# 비밀키 (단, *.example 은 커밋)
secrets/*
!secrets/*.example

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 실험 산출물(probe가 생성하는 이미지 덤프 — 재생성 가능)
experiments/vision_probe/out/
experiments/vision_probe/out_multi/

# 임시 정리 폴더(전송/추출 잔여물 — 수동 삭제용)
_to_delete/

# 로그(일자별 회전) · 실행 PID
logs/
.run/

# 일회성 공지 스크립트(개발자 ID 하드코딩)
experiments/announce.py
